# Backend Environment Configuration
# Copy this file to .env and configure your values

# Port the backend server listens on
# Default: 3000
PORT=3000

# MongoDB connection string
# For local development: mongodb://localhost:27017/literaria-nocturna
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/literaria-nocturna

# CORS allowed origins (comma-separated)
# Default: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Rate limiting
# Window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window (default: 100)
RATE_LIMIT_MAX=100

# Request body size limit
# Default: 1mb
REQUEST_BODY_LIMIT=1mb
