# Backend Environment Configuration
# Copy this file to .env and configure your values

# Port the backend server listens on
# Default: 3000
PORT=3000

# MongoDB connection string
# For local development: mongodb://localhost:27017/literaria-nocturna
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/literaria-nocturna
