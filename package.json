{
  "name": "literaria-nocturna",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ci": "playwright test --project=chromium --project=chromium-isolated",
    "test:e2e:cross-browser": "E2E_EXTENDED_MATRIX=1 playwright test --project=firefox-desktop --project=webkit-desktop",
    "test:e2e:responsive": "E2E_EXTENDED_MATRIX=1 playwright test --project=chromium-mobile --project=chromium-tablet",
    "test:e2e:full": "E2E_EXTENDED_MATRIX=1 playwright test",
    "test:e2e:staging": "E2E_STAGING=1 playwright test --project=chromium-staging",
    "test:e2e:staging:headed": "E2E_STAGING=1 playwright test --project=chromium-staging --headed",
    "test:e2e:staging:full": "E2E_STAGING=1 playwright test --project=chromium-staging --project=chromium-staging-isolated",
    "e2e:cleanup-stale": "tsx scripts/e2e-cleanup-stale.ts --dry-run",
    "e2e:cleanup-stale:force": "tsx scripts/e2e-cleanup-stale.ts --force"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "husky": "^9.1.7",
    "mongodb": "^7.6.0",
    "tsx": "^4.23.12"
  }
}
